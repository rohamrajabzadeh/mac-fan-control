/* MacFans 2.0 — dark, layered, gradient-accented theme.
   Most controls are custom-painted (see prowidgets.cpp); this sheet styles
   surfaces, typography and the remaining standard widgets. */

QWidget {
    color: #eef1f6;
    font-size: 13px;
}

QMainWindow, #root { background: #121419; }

/* ---------- header ---------- */
#header {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #191c23, stop:1 #15181e);
    border-bottom: 1px solid #23272f;
}
#title { font-size: 19px; font-weight: 800; color: #f4f6fa; }
#subtitle { font-size: 11.5px; color: #7f8899; }

/* ---------- pages ---------- */
#page, #pageScroll, #pageScroll > QWidget > QWidget { background: #121419; }
#pageTitle { font-size: 22px; font-weight: 800; color: #f4f6fa; }
#pageSub { font-size: 12px; color: #7f8899; }

/* ---------- cards ---------- */
#card {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1c1f27, stop:1 #181b22);
    border: 1px solid #262a33;
    border-radius: 18px;
}
#cardTitle { font-size: 15px; font-weight: 700; color: #f1f3f7; background: transparent; }
#cardSub { font-size: 11.5px; color: #7f8899; background: transparent; }
#sectionTitle { font-size: 12px; font-weight: 800; color: #8b93a3; background: transparent; }

QLabel { background: transparent; }

#modeBadge {
    color: white;
    font-size: 10.5px;
    font-weight: 800;
    border-radius: 10px;
    padding: 4px 11px;
}

#capLabel { font-size: 10px; font-weight: 800; color: #6e7686; }
#bigValue { font-size: 26px; font-weight: 800; color: #f4f6fa; }
#midValue { font-size: 13.5px; font-weight: 700; color: #d6dbe4; }
#accentValue { font-size: 14px; font-weight: 800; color: #7cd4ff; }
#rowLabel { font-size: 12.5px; font-weight: 600; color: #a3abba; }
#panelText { font-size: 12.5px; color: #b3bac7; }
#hintText { font-size: 11.5px; color: #6e7686; }
#statusText { font-size: 12px; color: #a3abba; }

#infoPanel {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid #262a33;
    border-radius: 12px;
}

#banner {
    background: rgba(245, 184, 74, 0.08);
    border: 1px solid rgba(245, 184, 74, 0.35);
    border-radius: 12px;
}
#bannerText { font-size: 12px; color: #f2d49b; }

/* ---------- temperatures ---------- */
#hotPill {
    font-size: 11.5px;
    font-weight: 700;
    border-radius: 11px;
    padding: 4px 11px;
}
#quickName { font-size: 12px; color: #a3abba; }
#quickVal { font-size: 12px; font-weight: 800; }
#treeScroll, #treeWrap { background: transparent; }
#chartNow { font-size: 15px; font-weight: 800; }

/* ---------- settings ---------- */
#rowTitle { font-size: 13.5px; font-weight: 700; color: #eef1f6; }
#rowDesc { font-size: 11.5px; color: #7f8899; }
#divider { background: #23272f; border: none; }

/* ---------- menu-bar popup ---------- */
#trayPopup { background: transparent; }
#popupCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1e2129, stop:1 #191c23);
    border: 1px solid #30353f;
    border-radius: 18px;
}
#popupTitle { font-size: 14.5px; font-weight: 800; color: #f4f6fa; }
#popupSub { font-size: 11.5px; color: #8b93a3; }
#popupRpm { color: #f4f6fa; }
#popupTempName { font-size: 12px; color: #a3abba; }
#popupTempVal { font-size: 12px; font-weight: 800; }
#popupNote { font-size: 11.5px; color: #a3abba; }
#popupAccent { font-size: 12.5px; font-weight: 800; color: #7cd4ff; }
#popupDivider { background: #2a2f39; border: none; }
#popupPill { font-size: 11px; font-weight: 800; border-radius: 9px; padding: 3px 9px; }
#popupCap { font-size: 9.5px; font-weight: 800; color: #6e7686; }

/* ---------- scroll bars ---------- */
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 4px 2px 4px 0; }
QScrollBar::handle:vertical { background: #2f3440; border-radius: 4px; min-height: 36px; }
QScrollBar::handle:vertical:hover { background: #3d4351; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollBar:horizontal { height: 0; }

/* ---------- menus & tooltips ---------- */
QMenu {
    background: #1d2028;
    border: 1px solid #30353f;
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 26px 7px 12px;
    border-radius: 7px;
    color: #e6e9ef;
}
QMenu::item:selected { background: #3a6fd8; color: white; }
QMenu::separator { height: 1px; background: #2a2f39; margin: 5px 8px; }
QMenu::icon { padding-left: 8px; }

QToolTip {
    background: #1d2028;
    color: #e6e9ef;
    border: 1px solid #30353f;
    border-radius: 7px;
    padding: 5px 8px;
}
